<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Total Budget + Spent -->

    <!-- Remaining Budget -->

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="206dp"
        android:layout_height="46dp"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="30dp"
        app:srcCompat="@drawable/manimate_namemmmmmmmm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_remaining_box2"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="103dp"
            android:background="@drawable/bg_remaining_box3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="294dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:text="Remaining"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvRemainingBudget"
                        android:layout_width="388dp"
                        android:layout_height="71dp"
                        android:layout_marginTop="2dp"
                        android:background="#000D2B1B"
                        android:padding="10dp"
                        android:text="Rs.0.00"
                        android:textColor="#ECF2F1"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="64dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="15dp"
                    app:srcCompat="@drawable/finance_traker_app2" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTotalBudget"
                android:layout_width="368dp"
                android:layout_height="72dp"
                android:layout_margin="10dp"
                android:background="#00B9B8BF"
                android:backgroundTint="#00B9B8BF"
                android:shadowColor="#E0DCDC"
                android:text="Budget: Rs.0.00\nSpent: Rs.0.00"
                android:textColor="#0F0E0E"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_remaining_box"
        android:max="100"
        android:progress="0"
        android:progressTint="#A68524" />

    <LinearLayout
        android:id="@+id/categorySummaryContainer"
        android:layout_width="match_parent"

        android:layout_height="487dp"
        android:layout_marginTop="8dp"
        android:background="#F8F4F4"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExpensesSummary"
            android:layout_width="375dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:text="@string/CategorySummary"
            android:textColor="#0F0E0E"
            android:textSize="24sp"
            android:textStyle="bold" />


        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChart"
            android:layout_width="match_parent"
            android:layout_height="317dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Summary Header -->

    <!-- Container for dynamic category items -->

    <!-- Budget progress bar -->


    <!-- Pie Chart -->

</LinearLayout>
